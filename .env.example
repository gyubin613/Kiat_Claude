# ── 필수 ───────────────────────────────────────────────
# 관리자 로그인 비밀번호 (배포 환경에서 미설정 시 로그인 불가)
ADMIN_PASSWORD=
# 세션 서명 키 (임의의 긴 문자열 권장, 예: openssl rand -hex 32)
SESSION_SECRET=

# ── 데이터 저장소 (Upstash Redis) ─────────────────────
# Vercel Marketplace에서 Upstash for Redis를 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN 이 자동 설정됩니다.
# 미설정 시 서버 메모리에 저장(로컬 시연 전용, 재시작 시 초기화)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 같은 Redis를 여러 환경이 함께 쓸 때 키 접두사 (예: kiat-preview:)
KV_PREFIX=kiat:

# ── 메일 실제 발송 ─────────────────────────────────────
# 방법 1) 메일 계정(SMTP) — 네이버·Gmail·기관 메일 (권장, 둘 다 있으면 SMTP 우선)
#   네이버: 메일 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용함, 내정보 > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호
SMTP_HOST=            # smtp.naver.com / smtp.gmail.com
SMTP_PORT=465         # 465(SSL) 또는 587(STARTTLS)
SMTP_USER=            # 전체 메일 주소
SMTP_PASS=            # 애플리케이션 비밀번호
# 방법 2) Resend (발신 도메인 인증 필요)
RESEND_API_KEY=
# 보내는 주소 (SMTP는 비워 두면 SMTP_USER 사용 — 네이버는 로그인 주소와 같아야 함)
EMAIL_FROM=
EMAIL_FROM_NAME=      # 받는 사람에게 보이는 이름 (예: 기술평가팀)
EMAIL_REPLY_TO=       # 답장 받을 주소 (비우면 ADMIN_NOTIFY_EMAIL)
# 위원에게 보낼 수 있는 주소 (쉼표 구분, @도메인 가능, * = 모두). 비어 있으면 위원에게는 보내지 않음
EMAIL_ALLOWED_RECIPIENTS=

# 위원 문의 접수·자동 후속 안내 처리 결과를 받을 담당자 메일 (발송 허용목록에도 포함해야 함)
ADMIN_NOTIFY_EMAIL=

# ── 무응답 자동 후속 안내 스케줄러 ────────────────────
# /api/cron/followup 호출 인증 키. Vercel Cron(하루 1회)과 GitHub Actions(매시간)가 사용
CRON_SECRET=

# ── 선택: 기타 ─────────────────────────────────────────
# 회신 링크에 사용할 기본 주소 (미설정 시 접속 주소 사용)
APP_BASE_URL=
# 앱 안 '피드백·버그 신고' 버튼이 연결될 GitHub 저장소 (owner/repo)
NEXT_PUBLIC_GITHUB_REPO=
